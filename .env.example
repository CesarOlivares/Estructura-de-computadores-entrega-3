# Copia opcional: `cp .env.example .env` y edita lo que quieras cambiar.
#
# NO ES OBLIGATORIO crear el .env: todos los valores de abajo son los defaults
# que ya trae el docker-compose.yml, y el sistema levanta sin este archivo.
# Existe para documentar en un solo lugar qué se puede configurar (Fase 13).

# --- Tiempos de ciclo de cada etapa, en segundos por lote -------------------
# Son los del diseño (docs/diseno.md). Se cambian para experimentar; p. ej.
# dividirlos por 10 acelera la línea entera para una prueba rápida.
CICLO_FILETEADO=4
CICLO_ENVASADO=12
CICLO_SELLADO=3
CICLO_ESTERILIZACION=7

# Ciclo de la réplica lenta de envasado (solo con --profile experimento).
CICLO_ENVASADO_LENTO=24

# --- Métricas y cuello de botella -------------------------------------------
# Ventana móvil (s) sobre la que se promedian esperas y servicios.
VENTANA_S=60

# --- Concurrencia ------------------------------------------------------------
# atomico = BRPOP, el modo correcto. ingenuo = reclamo en dos pasos, que
# reproduce la condición de carrera de la Fase 6 (solo para la demo).
MODO_RECLAMO=atomico

# --- Manejo de errores (Fase 12) ----------------------------------------------
# Segundos que un servicio espera a Redis antes de darlo por caído (503 en
# ordenes, en_cola null en metricas). Cubre también el cuelgue del DNS.
PLAZO_REDIS_S=2
